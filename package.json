{
  "name": "leadflow-workspace",
  "version": "1.0.0",
  "description": "LeadFlow - Lightweight CRM for Financial Advisors and Sales Teams by Pravar AI",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
