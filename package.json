    "test:backend": "cd backend && python test_api.py",
    "seed": "cd backend && python -m app.seed"
  },
  "keywords": [
    "crm",
    "lead-management",
    "fastapi",
    "nextjs",
    "wealth-management",
    "pravar-ai"
  ],
